    size_t controls=0,failures=0;
    for(const auto& sample:samples) {
        const auto value=dbms::ExprHelper::evalString(sample.expression,{});
        const bool good=sample.state.empty()?value.ok && value.isNull==sample.null && value.typeName==sample.type && (value.isNull || value.value==sample.value):!value.ok && value.sqlState==sample.state;
        ++controls;
        if(!good) {++failures;std::cerr<<"TEMPORAL_PART_INPUT_NATIVE_FAIL "<<sample.expression<<" value="<<value.value<<" type="<<value.typeName<<" null="<<value.isNull<<" state="<<value.sqlState<<'\n';}
    }
    if(controls!=948)++failures;
    std::cout<<"TEMPORAL_PART_INPUT_NATIVE_COMPLETE "<<controls<<" FAILURES "<<failures<<'\n';
    return failures?1:0;
